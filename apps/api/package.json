    "@nestjs/terminus": "12.1.0",
    "@nestjs/typeorm": "12.0.2",
    "@workspace/contracts": "workspace:*",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.12",
    "pg": "8.23.1",
