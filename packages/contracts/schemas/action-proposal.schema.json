{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-proposal.schema.json",
  "title": "ActionProposal",
  "description": "X-09: one proposed tool action; tool arguments are snake_case as in the report.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {
          "const": "read_invoice"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invoice_id"],
          "properties": {
            "invoice_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {
          "const": "read_vendor"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor_id"],
          "properties": {
            "vendor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {
          "const": "create_report"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "source_invoice_ids"],
          "properties": {
            "template": {
              "enum": ["internal_investigation_v1", "vendor_reconciliation_v1"]
            },
            "source_invoice_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {
          "const": "queue_report"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["report_id", "recipient_reference"],
          "properties": {
            "report_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "recipient_reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            }
          }
        }
      }
    }
  ]
}
