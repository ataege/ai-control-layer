{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-state.schema.json",
  "title": "RunState",
  "description": "X-11: the state of one run (runtime.runs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "passportId",
    "status",
    "terminalReason",
    "cancelRequestedAt",
    "createdAt",
    "updatedAt",
    "resultReference"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "passportId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {
      "enum": ["queued", "running", "awaiting_approval", "paused", "completed", "failed", "stopped"]
    },
    "terminalReason": {
      "anyOf": [
        {
          "enum": [
            "resource_out_of_scope",
            "destination_not_allowed",
            "report_export_restricted",
            "report_lineage_missing",
            "source_policy_changed",
            "template_not_allowed",
            "approval_required",
            "approval_expired",
            "action_changed",
            "resource_version_changed",
            "allowance_exhausted",
            "run_cancelled",
            "outcome_unknown",
            "semantic_injection_detected",
            "security_evaluator_unavailable",
            "security_allowance_exhausted",
            "content_redacted",
            "signature_match",
            "policy_reload_rejected",
            "model_not_allowed",
            "multiple_actions_not_supported",
            "run_expired",
            "tool_not_registered",
            "invalid_arguments",
            "tool_not_allowed",
            "decision_unavailable",
            "content_blocked",
            "content_too_large",
            "limit_not_allowed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "cancelRequestedAt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "resultReference": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reportIds"],
          "properties": {
            "reportIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "if": {
    "properties": {
      "status": {
        "enum": ["paused", "failed", "stopped"]
      }
    }
  },
  "then": {
    "properties": {
      "terminalReason": {
        "enum": [
          "resource_out_of_scope",
          "destination_not_allowed",
          "report_export_restricted",
          "report_lineage_missing",
          "source_policy_changed",
          "template_not_allowed",
          "approval_required",
          "approval_expired",
          "action_changed",
          "resource_version_changed",
          "allowance_exhausted",
          "run_cancelled",
          "outcome_unknown",
          "semantic_injection_detected",
          "security_evaluator_unavailable",
          "security_allowance_exhausted",
          "content_redacted",
          "signature_match",
          "policy_reload_rejected",
          "model_not_allowed",
          "multiple_actions_not_supported",
          "run_expired",
          "tool_not_registered",
          "invalid_arguments",
          "tool_not_allowed",
          "decision_unavailable",
          "content_blocked",
          "content_too_large",
          "limit_not_allowed"
        ]
      }
    }
  },
  "else": {
    "properties": {
      "terminalReason": {
        "type": "null"
      }
    }
  }
}
