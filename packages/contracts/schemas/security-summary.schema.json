{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "security-summary.schema.json",
  "title": "SecuritySummary",
  "description": "X-93 input (GO-83): the organization's security records aggregated: runs by status, decisions by type, decision, reason and input source, assessments by control, outcome, verdict source and input source, model usage per purpose (judge probes' security calls also counted apart), observed timings per phase in microseconds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizationId",
    "generatedAt",
    "runs",
    "decisions",
    "assessments",
    "modelUsage",
    "judgeSecurityCalls",
    "timings"
  ],
  "properties": {
    "organizationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "count"],
        "properties": {
          "status": {
            "enum": [
              "queued",
              "running",
              "awaiting_approval",
              "paused",
              "completed",
              "failed",
              "stopped"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventType", "decision", "reasonCode", "inputSource", "count"],
        "properties": {
          "eventType": {
            "enum": [
              "admission.rejected",
              "run.queued",
              "run.started",
              "run.paused",
              "run.completed",
              "run.failed",
              "run.stopped",
              "run.cancel_requested",
              "run.awaiting_approval",
              "run.resumed",
              "model.completed",
              "action.proposed",
              "action.allowed",
              "action.denied",
              "approval.requested",
              "approval.decided",
              "action.executing",
              "action.succeeded",
              "action.failed",
              "action.unknown",
              "report.created",
              "report.export_denied",
              "report.safe_template_offered",
              "control.evaluated",
              "catalog.revision_rejected"
            ]
          },
          "decision": {
            "anyOf": [
              {
                "enum": ["allow", "deny", "approval_required", "redact", "approved", "rejected"]
              },
              {
                "type": "null"
              }
            ]
          },
          "reasonCode": {
            "anyOf": [
              {
                "enum": [
                  "resource_out_of_scope",
                  "destination_not_allowed",
                  "report_export_restricted",
                  "report_lineage_missing",
                  "source_policy_changed",
                  "template_not_allowed",
                  "approval_required",
                  "approval_expired",
                  "action_changed",
                  "resource_version_changed",
                  "allowance_exhausted",
                  "run_cancelled",
                  "outcome_unknown",
                  "semantic_injection_detected",
                  "security_evaluator_unavailable",
                  "security_allowance_exhausted",
                  "content_redacted",
                  "signature_match",
                  "policy_reload_rejected",
                  "model_not_allowed",
                  "multiple_actions_not_supported",
                  "run_expired",
                  "tool_not_registered",
                  "invalid_arguments",
                  "tool_not_allowed",
                  "decision_unavailable",
                  "content_blocked",
                  "content_too_large",
                  "limit_not_allowed",
                  "run_not_active",
                  "approval_rejected"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "inputSource": {
            "anyOf": [
              {
                "enum": ["judge"]
              },
              {
                "type": "null"
              }
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "controlClass",
          "controlId",
          "outcome",
          "verdictSource",
          "inputSource",
          "count"
        ],
        "properties": {
          "controlClass": {
            "enum": ["deterministic", "semantic"]
          },
          "controlId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "outcome": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "verdictSource": {
            "anyOf": [
              {
                "enum": ["live", "fixture"]
              },
              {
                "type": "null"
              }
            ]
          },
          "inputSource": {
            "anyOf": [
              {
                "enum": ["judge"]
              },
              {
                "type": "null"
              }
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "modelUsage": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "dispatched",
            "completed",
            "failed",
            "usageUnknown",
            "inFlight",
            "settledTokens",
            "heldTokens",
            "usageUnknownReservations"
          ],
          "properties": {
            "purpose": {
              "const": "agent"
            },
            "dispatched": {
              "type": "integer",
              "minimum": 0
            },
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "usageUnknown": {
              "type": "integer",
              "minimum": 0
            },
            "inFlight": {
              "type": "integer",
              "minimum": 0
            },
            "settledTokens": {
              "type": "integer",
              "minimum": 0
            },
            "heldTokens": {
              "type": "integer",
              "minimum": 0
            },
            "usageUnknownReservations": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "dispatched",
            "completed",
            "failed",
            "usageUnknown",
            "inFlight",
            "settledTokens",
            "heldTokens",
            "usageUnknownReservations"
          ],
          "properties": {
            "purpose": {
              "const": "security"
            },
            "dispatched": {
              "type": "integer",
              "minimum": 0
            },
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "usageUnknown": {
              "type": "integer",
              "minimum": 0
            },
            "inFlight": {
              "type": "integer",
              "minimum": 0
            },
            "settledTokens": {
              "type": "integer",
              "minimum": 0
            },
            "heldTokens": {
              "type": "integer",
              "minimum": 0
            },
            "usageUnknownReservations": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "judgeSecurityCalls": {
      "type": "integer",
      "minimum": 0
    },
    "timings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "count",
          "failed",
          "medianMicroseconds",
          "p95Microseconds",
          "maxMicroseconds"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "medianMicroseconds": {
            "type": "integer",
            "minimum": 0
          },
          "p95Microseconds": {
            "type": "integer",
            "minimum": 0
          },
          "maxMicroseconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
