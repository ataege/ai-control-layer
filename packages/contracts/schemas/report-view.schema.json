{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-view.schema.json",
  "title": "ReportView",
  "description": "X-64 (GO-37): one stored report as the interface reads it, with its stored label and lineage summary; content is null exactly when it is withheld.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportId",
    "runId",
    "version",
    "template",
    "templateVersion",
    "projectionRule",
    "projectionRuleVersion",
    "classification",
    "destinationClass",
    "title",
    "contentHash",
    "content",
    "contentWithheld",
    "lineage"
  ],
  "properties": {
    "reportId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "template": {
      "enum": ["internal_investigation_v1", "vendor_reconciliation_v1"]
    },
    "templateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "projectionRule": {
      "anyOf": [
        {
          "enum": ["vendor_invoice_fields_v1"]
        },
        {
          "type": "null"
        }
      ]
    },
    "projectionRuleVersion": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "enum": ["internal_only", "vendor_shareable"]
    },
    "destinationClass": {
      "enum": ["internal_reviewers", "registered_vendor_recipient"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "contentWithheld": {
      "type": "boolean"
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKind", "sourceId", "sourceVersion", "classification", "consumedFields"],
        "properties": {
          "sourceKind": {
            "enum": ["invoice"]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "enum": ["internal_only", "vendor_shareable"]
          },
          "consumedFields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contentWithheld": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "null"
          },
          "classification": {
            "const": "internal_only"
          }
        }
      },
      "else": {
        "properties": {
          "content": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "template": {
            "const": "vendor_reconciliation_v1"
          }
        }
      },
      "then": {
        "properties": {
          "projectionRule": {
            "const": "vendor_invoice_fields_v1"
          },
          "projectionRuleVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "projectionRule": {
            "type": "null"
          },
          "projectionRuleVersion": {
            "type": "null"
          }
        }
      }
    }
  ]
}
