{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safe-event.schema.json",
  "title": "SafeEvent",
  "description": "X-12: a sanitized decision event (runtime.audit_events); masked metadata only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "organizationId",
    "runId",
    "actionId",
    "eventType",
    "decision",
    "reasonCode",
    "catalogRevisionId",
    "maskedSummary",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "runId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "actionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "eventType": {
      "enum": [
        "admission.rejected",
        "run.queued",
        "run.started",
        "run.paused",
        "run.completed",
        "run.failed",
        "run.stopped",
        "model.completed",
        "action.proposed",
        "action.allowed",
        "action.denied",
        "approval.requested",
        "approval.decided",
        "action.executing",
        "action.succeeded",
        "action.failed",
        "action.unknown",
        "report.created",
        "report.export_denied",
        "report.safe_template_offered",
        "control.evaluated",
        "catalog.revision_rejected"
      ]
    },
    "decision": {
      "anyOf": [
        {
          "enum": ["allow", "deny", "approval_required", "redact", "approved", "rejected"]
        },
        {
          "type": "null"
        }
      ]
    },
    "reasonCode": {
      "anyOf": [
        {
          "enum": [
            "resource_out_of_scope",
            "destination_not_allowed",
            "report_export_restricted",
            "report_lineage_missing",
            "source_policy_changed",
            "template_not_allowed",
            "approval_required",
            "approval_expired",
            "action_changed",
            "resource_version_changed",
            "allowance_exhausted",
            "run_cancelled",
            "outcome_unknown",
            "semantic_injection_detected",
            "security_evaluator_unavailable",
            "security_allowance_exhausted",
            "content_redacted",
            "signature_match",
            "policy_reload_rejected",
            "model_not_allowed",
            "multiple_actions_not_supported",
            "run_expired",
            "tool_not_registered",
            "invalid_arguments",
            "tool_not_allowed",
            "decision_unavailable",
            "content_blocked",
            "content_too_large",
            "limit_not_allowed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "catalogRevisionId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "maskedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "admissionCatalogRevisionId",
        "matchedRule",
        "feedRevision",
        "reportId",
        "template",
        "classification",
        "lineageCheck",
        "effect",
        "replaySource",
        "alternativeTemplate",
        "safeMessage"
      ],
      "properties": {
        "purpose": {
          "anyOf": [
            {
              "enum": ["agent", "security"]
            },
            {
              "type": "null"
            }
          ]
        },
        "admissionCatalogRevisionId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "matchedRule": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "feedRevision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reportId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "template": {
          "anyOf": [
            {
              "enum": ["internal_investigation_v1", "vendor_reconciliation_v1"]
            },
            {
              "type": "null"
            }
          ]
        },
        "classification": {
          "anyOf": [
            {
              "enum": ["internal_only", "vendor_shareable"]
            },
            {
              "type": "null"
            }
          ]
        },
        "lineageCheck": {
          "anyOf": [
            {
              "enum": ["passed", "failed", "missing"]
            },
            {
              "type": "null"
            }
          ]
        },
        "effect": {
          "anyOf": [
            {
              "enum": ["none", "read", "report_created", "outbox_message_queued"]
            },
            {
              "type": "null"
            }
          ]
        },
        "replaySource": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "alternativeTemplate": {
          "anyOf": [
            {
              "enum": ["internal_investigation_v1", "vendor_reconciliation_v1"]
            },
            {
              "type": "null"
            }
          ]
        },
        "safeMessage": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "occurredAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  },
  "if": {
    "properties": {
      "actionId": {
        "type": "string"
      }
    }
  },
  "then": {
    "properties": {
      "runId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    }
  }
}
