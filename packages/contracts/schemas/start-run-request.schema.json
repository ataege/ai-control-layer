{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "start-run-request.schema.json",
  "title": "StartRunRequest",
  "description": "X-07 as landed by the web + API implementer; mirrors apps/api StartRunSchema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["template", "invoiceIds", "destination"],
  "properties": {
    "template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "vendorId": {
      "type": "string",
      "maxLength": 256
    },
    "invoiceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 100
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approvalRequirement": {
      "type": "string",
      "maxLength": 256
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  }
}
