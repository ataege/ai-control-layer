# Copy of the variables the starter reads. `pnpm run setup` creates .env from this file
# and fills every value marked "generated" with a random local secret.
# Never commit .env and never put real secrets in this file.

# --- PostgreSQL (one instance, shared by the API and the gateway) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=starter
# generated by setup
POSTGRES_PASSWORD=
POSTGRES_DB=starter
# The gateway connects as its own role, task_passport_gateway (fixed name), with this password;
# `pnpm db:roles` sets it on the role after the migrations. generated by setup
POSTGRES_GATEWAY_PASSWORD=

# --- Ports (host development and published Compose ports) ---
WEB_PORT=3000
API_PORT=3001
GATEWAY_PORT=8080

# --- Optional bind addresses (defaults shown; the container images set 0.0.0.0) ---
# API_HOST=127.0.0.1
# GATEWAY_HOST=127.0.0.1
# WEB_HOST=127.0.0.1   (used by `pnpm --filter web run start` only)

# --- Service wiring for host development ---
# Full-container mode overrides these with Compose service names (see infra/compose.yaml).
# Where the Next.js server reaches the NestJS API. Server-side only.
API_UPSTREAM_URL=http://localhost:3001
# Where the NestJS API reaches the Go gateway.
GATEWAY_URL=http://localhost:8080
# Comma-separated browser origins allowed by the API's CORS policy.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Local model (Go gateway only) ---
# Read by the gateway only; the web app and the API never receive these. Not secrets.
# Where the gateway reaches Ollama on the host (Ollama's default port).
MODEL_BASE_URL=http://localhost:11434
# Ollama model tag, set after `ollama pull`. Which model is still open (decision 6).
MODEL_NAME=

# --- Service-to-service token (API -> gateway /internal/ping) ---
# generated by setup. Server-side only: never expose it through NEXT_PUBLIC_* variables.
GATEWAY_SERVICE_TOKEN=

# --- Authentication and operator context (decisions 7 and 4) ---
# generated by setup. Signs the operator's session JWT in the HttpOnly cookie. Read by the API only:
# never by the gateway or the web app, never in a NEXT_PUBLIC_* variable.
AUTH_JWT_SECRET=
# Set locally before explicit pnpm db:seed. Development demonstration only; never a startup seed.
DEMO_OPERATOR_PASSWORD=
# generated by setup. Signs the short-lived operator-context JWT that the API sends to the gateway in
# the X-Operator-Context header. Read by the API and the gateway only, never by the web app.
OPERATOR_CONTEXT_SIGNING_KEY=

# --- Timeouts and logging ---
# Upper bound for one API -> gateway call, in milliseconds.
GATEWAY_TIMEOUT_MS=3000
# Upper bound for one database connection or readiness check, in milliseconds.
DATABASE_TIMEOUT_MS=3000
# debug | info | warn | error
LOG_LEVEL=info
